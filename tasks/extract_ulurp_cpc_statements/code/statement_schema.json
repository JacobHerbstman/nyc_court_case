{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPC report statements",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "application_number", "segments_read", "reading_notes", "statements"],
  "properties": {
    "document_id": {"type": "string"},
    "application_number": {"type": "string"},
    "segments_read": {"type": "array", "items": {"type": "string"}},
    "reading_notes": {"type": "string"},
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement_id", "segment_ids", "quote", "source_part",
          "application", "application_basis",
          "actor_name", "actor_roles", "office_or_affiliation", "project_team", "speaks_for",
          "statement_type", "certainty", "summary", "stance_on_project", "component", "votes",
          "response", "response_statement_ids", "stage", "timing_note",
          "topics", "topic_note", "note"
        ],
        "properties": {
          "statement_id": {"type": "integer", "minimum": 1},
          "segment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "quote": {"type": "string", "minLength": 1},
          "source_part": {"enum": [
            "cpc_report", "community_board_recommendation", "borough_president_recommendation",
            "borough_board_recommendation", "letter", "hearing_minutes_or_testimony",
            "restrictive_declaration", "agency_document", "other"]},
          "application": {"type": "string", "description": "An application number, bundle_general, other_project or unclear."},
          "application_basis": {"type": "string"},
          "actor_name": {"type": "string"},
          "actor_roles": {"type": "array", "minItems": 1, "items": {"enum": [
            "council_member", "community_board", "borough_president", "borough_board", "cpc",
            "city_planning_staff", "city_agency", "state_or_federal_agency", "other_elected_official",
            "applicant", "applicant_representative", "sponsor_or_developer", "operator_or_occupant",
            "civic_organization", "business_or_trade_group", "labor_union", "institution",
            "resident", "unidentified_speaker", "other"]}},
          "office_or_affiliation": {"type": "string"},
          "project_team": {"enum": ["yes", "no", "unclear"]},
          "speaks_for": {"enum": ["organization", "office", "self", "unclear"]},
          "statement_type": {"enum": [
            "position", "concern", "request", "applicant_commitment", "requirement",
            "modification", "proposal_description", "finding", "decision"]},
          "certainty": {"enum": ["definite", "conditional", "tentative", "not_applicable"]},
          "summary": {"type": "string", "minLength": 1},
          "stance_on_project": {"enum": ["support", "conditional_support", "oppose", "mixed", "none_stated"]},
          "component": {"type": "string"},
          "votes": {"type": "string"},
          "response": {"enum": [
            "adopted", "partly_adopted", "rejected", "addressed_otherwise",
            "not_addressed", "unclear", "not_applicable"]},
          "response_statement_ids": {"type": "array", "items": {"type": "integer"}},
          "stage": {"enum": [
            "pre_certification", "community_board", "borough_president", "borough_board",
            "cpc_hearing", "cpc_consideration", "cpc_decision", "after_cpc", "unstated"]},
          "timing_note": {"type": "string"},
          "topics": {"type": "array", "items": {"enum": [
            "affordability", "displacement", "neighborhood_character", "scale_density_design",
            "historic_preservation", "traffic_parking", "infrastructure_services",
            "environment_open_space", "jobs_economy", "process", "other"]}},
          "topic_note": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
