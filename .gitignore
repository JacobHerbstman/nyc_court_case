# #################################################
# ## Generic gitignore for a task-based workflow
# #################################################

# --- System & Editor Files ---
.DS_Store
.Rhistory
__pycache__/
node_modules/
.claude/

# --- Log files ---
*.log
slurmlogs/
tasks/*/slurmlogs/

# --- Raw & Intermediate Data ---
data_raw/
tasks/*/input/
tasks/*/output/
tasks/*/temp/
tasks/audits/*/input/
tasks/audits/*/output/
tasks/audits/*/temp/
tasks/audits/*/slurmlogs/

# Production source ledgers intentionally committed for replication.
!tasks/stage_member_deference_nonapproval_geography_review/output/
!tasks/stage_member_deference_nonapproval_geography_review/output/*.csv
!tasks/stage_zap_source_integrity/output/
!tasks/stage_zap_source_integrity/output/*.csv
!tasks/stage_ulurp_modification_zap_documents/output/
!tasks/stage_ulurp_modification_zap_documents/output/*.csv

# --- Secrets ---
.Renviron

# --- Archive / deprecated task areas ---
tasks/_deprecated/
tasks/archive/
tasks/archive/*/input/
tasks/archive/*/output/
tasks/archive/*/temp/

# Exception: track the task flow graph for README if present
!tasks/symlink_graph/output/
tasks/symlink_graph/output/graph.txt
!tasks/symlink_graph/output/task_flow.png

# --- Paper build artifacts ---
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fff
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.ttt

# --- Slides build artifacts ---
slides/*.aux
slides/*.bbl
slides/*.blg
slides/*.fdb_latexmk
slides/*.fls
slides/*.log
slides/*.nav
slides/*.out
slides/*.pdf
slides/*.synctex.gz
slides/*.snm
slides/*.toc
slides/figures/institutional_timeline_units_total_ma3.csv
class_slides/*.aux
class_slides/*.bbl
class_slides/*.blg
class_slides/*.fdb_latexmk
class_slides/*.fls
class_slides/*.log
class_slides/*.nav
class_slides/*.out
class_slides/*.pdf
class_slides/*.synctex.gz
class_slides/*.snm
class_slides/*.toc
class_slides/figures/institutional_timeline_units_total_ma3.csv
class_slides/figures/institutional_timeline_units_total_count_ma3.csv

# --- Scratch / local working area ---
tmp/
LOCAL_PROJECT_MEMO.md
paper/aea.bst

# --- Auto-generated graphics ---
Rplots.pdf
**/code/Rplots.pdf
