# #################################################
# ## Generic gitignore for a task-based workflow
# #################################################

# --- System & Editor Files ---
.DS_Store
.Rhistory
__pycache__/
node_modules/
.claude/

# --- Log files ---
*.log
slurmlogs/
tasks/*/slurmlogs/

# --- Raw & Intermediate Data ---
data_raw/*
!data_raw/dcp_boundary_city_council_districts_archive/
data_raw/dcp_boundary_city_council_districts_archive/*
!data_raw/dcp_boundary_city_council_districts_archive/10C/
data_raw/dcp_boundary_city_council_districts_archive/10C/*
!data_raw/dcp_boundary_city_council_districts_archive/10C/nycc_10cav.zip
tasks/*/input/
tasks/*/output/
tasks/*/temp/
tasks/audits/*/input/
tasks/audits/*/output/
tasks/audits/*/temp/
tasks/audits/*/slurmlogs/

# Main task graph displayed in the root README.
!tasks/task_graph/output/
tasks/task_graph/output/*
!tasks/task_graph/output/task_flow.png

# Production source ledgers intentionally committed for replication.
!tasks/create_council_land_use_geography_review_ledgers/output/
tasks/create_council_land_use_geography_review_ledgers/output/*
!tasks/create_council_land_use_geography_review_ledgers/output/member_deference_nonapproval_geography_review_queue.csv
!tasks/create_council_land_use_geography_review_ledgers/output/member_deference_nonapproval_geography_chatgpt_review_responses.csv
!tasks/record_ulurp_cpc_source_corrections/output/
tasks/record_ulurp_cpc_source_corrections/output/*
!tasks/record_ulurp_cpc_source_corrections/output/ulurp_cpc_index_additions.csv
!tasks/record_ulurp_cpc_source_corrections/output/ulurp_cpc_source_corrections.csv

# Audit coding ledgers intentionally committed for replication.
!tasks/audits/record_ulurp_cpc_source_validation/output/
tasks/audits/record_ulurp_cpc_source_validation/output/*
!tasks/audits/record_ulurp_cpc_source_validation/output/official_ulurp_cpc_document_validation_labels.csv
!tasks/audits/record_ulurp_cpc_source_validation/output/official_ulurp_cpc_external_reference_exclusions.csv
!tasks/audits/record_ulurp_cpc_source_validation/output/official_ulurp_cpc_narrative_boundary_exceptions.csv
!tasks/audits/record_ulurp_cpc_source_validation/output/official_ulurp_cpc_short_page_validation.csv
!tasks/audits/record_ulurp_cpc_source_validation/output/official_ulurp_cpc_source_exception_labels.csv
!tasks/audits/record_ulurp_cpc_text_analysis_decisions/output/
tasks/audits/record_ulurp_cpc_text_analysis_decisions/output/*
!tasks/audits/record_ulurp_cpc_text_analysis_decisions/output/ulurp_cpc_community_district_corrections.csv
!tasks/audits/record_ulurp_cpc_text_analysis_decisions/output/ulurp_cpc_event_validation_labels.csv
!tasks/audits/record_ulurp_cpc_text_analysis_decisions/output/ulurp_cpc_initial_event_labels.csv
!tasks/audits/record_ulurp_cpc_text_analysis_decisions/output/ulurp_cpc_kwic_calibration_labels.csv

# --- Secrets ---
.Renviron

# --- Archive / deprecated task areas ---
tasks/_deprecated/
tasks/audits/archive/

# --- Paper build artifacts ---
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fff
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.ttt
paper/input/

# --- Slides build artifacts ---
slides/*.aux
slides/*.bbl
slides/*.blg
slides/*.fdb_latexmk
slides/*.fls
slides/*.log
slides/*.nav
slides/*.out
slides/*.pdf
slides/*.synctex.gz
slides/*.snm
slides/*.toc
slides/figures/institutional_timeline_units_total_ma3.csv
class_slides/*.aux
class_slides/*.bbl
class_slides/*.blg
class_slides/*.fdb_latexmk
class_slides/*.fls
class_slides/*.log
class_slides/*.nav
class_slides/*.out
class_slides/*.pdf
class_slides/*.synctex.gz
class_slides/*.snm
class_slides/*.toc
class_slides/figures/institutional_timeline_units_total_ma3.csv
class_slides/figures/institutional_timeline_units_total_count_ma3.csv

# --- Scratch / local working area ---
tmp/
LOCAL_PROJECT_MEMO.md

# --- Auto-generated graphics ---
Rplots.pdf
**/code/Rplots.pdf
